# Copy to .env and fill in the two hashes. Compose reads this file twice: for
# the published address below and as the service's environment. An empty value
# means the default.

# Host address and port Compose publishes the service on. Keep loopback and put
# tailscale serve or a TLS reverse proxy in front (README). Never a public address.
REPORTS_BIND_ADDRESS=127.0.0.1
REPORTS_PORT=8787

# SHA-256 hex of each token, comma-separated to allow rotation overlap.
# Generate a token and its hash: docker compose run --rm site-reports token
# The reporter token goes into the phone; the agent token into Paseo.
REPORTS_REPORTER_TOKEN_SHA256=
REPORTS_AGENT_TOKEN_SHA256=

# Largest POST /v1/reports body, in MiB (1 to 64). It must exceed 4/3 of the
# screenshot limit, the size of a screenshot in base64.
REPORTS_MAX_REQUEST_MB=12
# Largest decoded screenshot, in MiB (1 to 48).
REPORTS_MAX_SCREENSHOT_MB=8
# Screenshot bytes kept in all; a report past it gets 507 until reports are
# resolved and purged, or deleted.
REPORTS_MAX_STORAGE_MB=1024
# New reports per reporter token per clock hour (1 to 10000); repeats do not count.
REPORTS_MAX_REPORTS_PER_HOUR=60
# Days a done or rejected report keeps its contents and screenshot (1 to 3650).
REPORTS_RESOLVED_RETENTION_DAYS=30
# Days the id record of a purged or deleted report is kept, so a late phone
# retry is not stored again (1 to 3650).
REPORTS_TOMBSTONE_RETENTION_DAYS=365
