* text=auto
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.rs text eol=lf
*.html text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
# Patches must apply byte for byte; diff context lines legitimately end in spaces.
*.patch text eol=lf -whitespace
*.png binary
*.jpg binary
*.webp binary
*.mp4 binary
*.gz binary
# Raw device output kept verbatim as evidence
docs/engine-spike/*.txt -whitespace
# Copied verbatim from the Rust toolchain by scripts/generate-notices.py
app/src/main/assets/notices/Rust-Licenses.html -whitespace
