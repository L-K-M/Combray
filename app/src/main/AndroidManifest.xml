<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        No backups: credentials, queued page content and the Servo profile (cookies) must not
        leave the device by default (docs/IMPLEMENTATION_PLAN.md section 7).
    -->
    <application
        android:name=".CombrayApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Combray">

        <!-- The page surface always accepts text input; only a focused page field
             (the engine's ime_shown event) shows the keyboard, never returning to the app. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Combray.Starting"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- Shared text: its first link opens in a new tab; other text waits in the address
                 editor, as does a web search request (IncomingIntents). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "Search with Kagi" in other apps' text selection menu: chosen there, so it searches at once. -->
        <activity-alias
            android:name=".SearchWithKagi"
            android:exported="true"
            android:label="@string/process_text_search_kagi"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- "Save to Karakeep" share target: one question over the sharing app, then a toast. An
             empty task affinity keeps it out of the browser's task, so sharing does not bring
             the browser forward. -->
        <activity
            android:name=".SaveToKarakeepActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_save_to_karakeep"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
