<?xml version="1.0" encoding="utf-8"?>
<!--
    Applies to Combray's own HTTP clients (Karakeep, Hister), not to web pages: Servo has its
    own network stack. A service address may be plain HTTP (a home server without a
    certificate); Settings says what that exposes. HTTPS uses system-trusted certificates.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
