 components/script/dom/webgl/extensions/ext/mod.rs  |  1 +
 .../webgl/extensions/ext/webgldebugrendererinfo.rs | 53 ++++++++++++++++++++++
 .../script/dom/webgl/extensions/extensions.rs      | 13 ++++--
 .../script/dom/webgl/webglrenderingcontext.rs      | 17 +++++++
 .../webidls/WEBGLDebugRendererInfo.webidl          | 15 ++++++
 components/shared/canvas/webgl.rs                  |  2 +
 components/webgl/webgl_thread.rs                   |  3 ++
 7 files changed, 101 insertions(+), 3 deletions(-)

