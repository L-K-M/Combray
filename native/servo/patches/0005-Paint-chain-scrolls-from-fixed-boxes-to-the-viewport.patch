From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Combray <combray@localhost>
Date: Wed, 21 Oct 2026 18:40:00 +0000
Subject: [PATCH] Paint: chain scrolls from fixed boxes to the viewport

Scroll nodes inside a position: fixed box are children of the root
reference frame, beside the viewport's scroll node. A scroll that such
a node cannot take ran out of ancestors without reaching the viewport.
Browsers chain it to the fixed box's containing block, the viewport.

Pages that keep a closed menu or dialog as an invisible fixed layer
with an overflow: auto box in it (Reddit's mobile navigation drawer)
could therefore not be scrolled by touch anywhere under that layer.
---
 components/shared/paint/display_list.rs     | 35 +++++++-
 components/shared/paint/tests/compositor.rs | 82 ++++++++++++++++++-
 2 files changed, 113 insertions(+), 4 deletions(-)

diff --git a/components/shared/paint/display_list.rs b/components/shared/paint/display_list.rs
index ae4e835..59dde53 100644
--- a/components/shared/paint/display_list.rs
+++ b/components/shared/paint/display_list.rs
@@ -550,6 +550,30 @@ impl ScrollTree {
             .and_then(|parent| self.scroll_node_or_ancestor_inner(parent, scroll_location, context))
     }
 
+    /// Scroll nodes inside a `position: fixed` box hang off the root reference frame, beside
+    /// the viewport's scroll node rather than under it, so chaining from them ends without
+    /// reaching the viewport. Their containing block is the viewport, though, and browsers
+    /// chain such scrolls to it: a swipe over a transparent fixed layer (a closed menu or
+    /// dialog) scrolls the page. Returns `None` when the viewport was already in the chain.
+    fn scroll_viewport_for_fixed_descendant(
+        &mut self,
+        scroll_node_id: ScrollTreeNodeId,
+        pipeline_id: PipelineId,
+        scroll_location: ScrollLocation,
+        context: ScrollType,
+    ) -> Option<(ExternalScrollId, LayoutVector2D)> {
+        let viewport_id =
+            self.node_with_external_scroll_node_id(ExternalScrollId(0, pipeline_id))?;
+        let mut ancestor = Some(scroll_node_id);
+        while let Some(id) = ancestor {
+            if id == viewport_id {
+                return None;
+            }
+            ancestor = self.get_node(id).parent;
+        }
+        self.get_node_mut(viewport_id).scroll(scroll_location, context)
+    }
+
     fn node_with_external_scroll_node_id(
         &self,
         external_id: ExternalScrollId,
@@ -595,7 +619,16 @@ impl ScrollTree {
         context: ScrollType,
     ) -> Option<(ExternalScrollId, LayoutVector2D)> {
         let scroll_node_id = self.node_with_external_scroll_node_id(external_id)?;
-        let result = self.scroll_node_or_ancestor_inner(scroll_node_id, scroll_location, context);
+        let result = self
+            .scroll_node_or_ancestor_inner(scroll_node_id, scroll_location, context)
+            .or_else(|| {
+                self.scroll_viewport_for_fixed_descendant(
+                    scroll_node_id,
+                    external_id.1,
+                    scroll_location,
+                    context,
+                )
+            });
         if result.is_some() {
             self.invalidate_cached_transforms();
         }
