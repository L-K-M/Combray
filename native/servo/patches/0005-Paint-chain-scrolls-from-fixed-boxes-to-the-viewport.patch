 fn add_mock_scroll_node(tree: &mut ScrollTree) -> (ScrollTreeNodeId, ExternalScrollId) {
     let pipeline_id = PipelineId(0, 0);
@@ -217,3 +220,76 @@ fn test_scroll_tree_chain_through_overflow_hidden() {
         Some(LayoutVector2D::new(0.0, 0.0))
     );
 }
+
+#[test]
+fn test_scroll_tree_chain_from_fixed_position_to_viewport() {
+    // The tree layout builds: boxes inside a `position: fixed` element hang off the root
+    // reference frame, beside the viewport's scroll node rather than under it.
+    let mut scroll_tree = ScrollTree::default();
+    let pipeline_id = PipelineId(0, 0);
+    let root_reference_frame_id = scroll_tree.add_scroll_tree_node(
+        None,
+        SpatialTreeNodeInfo::ReferenceFrame(ReferenceFrameNodeInfo {
+            origin: Default::default(),
+            frame_origin_for_query: Default::default(),
+            transform_style: TransformStyle::Flat,
+            transform: FastLayoutTransform::identity(),
+            kind: ReferenceFrameKind::default(),
+        }),
+    );
+    let add_scroll_node = |tree: &mut ScrollTree, external_id, content_height| {
+        tree.add_scroll_tree_node(
+            Some(root_reference_frame_id),
+            SpatialTreeNodeInfo::Scroll(ScrollableNodeInfo {
+                external_id,
+                content_rect: Size2D::new(100.0, content_height).into(),
+                clip_rect: Size2D::new(100.0, 100.0).into(),
+                scroll_sensitivity: AxesScrollSensitivity {
+                    x: ScrollType::Script | ScrollType::InputEvents,
+                    y: ScrollType::Script | ScrollType::InputEvents,
+                },
+                touch_action: TouchAction::Auto,
+                offset: LayoutVector2D::zero(),
+                offset_changed: Cell::new(false),
+            }),
+        )
+    };
+    let viewport_external_id = ExternalScrollId(0, pipeline_id);
+    let viewport_id = add_scroll_node(&mut scroll_tree, viewport_external_id, 300.0);
+    // An `overflow: auto` box in a fixed element whose content fits: it cannot scroll.
+    let fixed_external_id = ExternalScrollId(1, pipeline_id);
+    let fixed_id = add_scroll_node(&mut scroll_tree, fixed_external_id, 100.0);
+
+    // Browsers chain such a scroll to the fixed element's containing block, the viewport.
+    let (scrolled_id, offset) = scroll_tree
+        .scroll_node_or_ancestor(
+            fixed_external_id,
+            ScrollLocation::Delta(LayoutVector2D::new(0.0, 40.0)),
+            ScrollType::InputEvents,
+        )
+        .unwrap();
+    let expected_offset = LayoutVector2D::new(0.0, 40.0);
+    assert_eq!(scrolled_id, viewport_external_id);
+    assert_eq!(offset, expected_offset);
+    assert_eq!(
+        scroll_tree.get_node(viewport_id).offset(),
+        Some(expected_offset)
+    );
+    assert_eq!(
+        scroll_tree.get_node(fixed_id).offset(),
+        Some(LayoutVector2D::zero())
+    );
+
+    // At the end of the page there is nothing left to scroll.
+    scroll_tree.scroll_node_or_ancestor(
+        viewport_external_id,
+        ScrollLocation::End,
+        ScrollType::InputEvents,
+    );
+    let result = scroll_tree.scroll_node_or_ancestor(
+        fixed_external_id,
+        ScrollLocation::Delta(LayoutVector2D::new(0.0, 40.0)),
+        ScrollType::InputEvents,
+    );
+    assert!(result.is_none());
+}
