index f42d147..d0cd170 100644
--- a/components/shared/paint/tests/compositor.rs
+++ b/components/shared/paint/tests/compositor.rs
@@ -6,12 +6,15 @@ use std::cell::Cell;
 
 use euclid::Size2D;
