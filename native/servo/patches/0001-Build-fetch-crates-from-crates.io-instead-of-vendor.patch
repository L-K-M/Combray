From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Combray <combray@localhost>
Date: Sun, 18 Oct 2026 12:28:41 +0000
Subject: [PATCH] Build: fetch crates from crates.io instead of vendor/

The v0.6.0 source tarball's vendor/ directory cannot build: the mozjs
glue crates run cbindgen, which runs cargo metadata against their own
Cargo.lock (encoding_rs 0.8.41) while vendor/ only has 0.8.35.
Fetching the same versions from crates.io (verified against Servo's
Cargo.lock checksums) is equivalent to building the v0.6.0 git tag.
---
 .cargo/config.toml | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/.cargo/config.toml b/.cargo/config.toml
index 0595ede..1c086c0 100644
--- a/.cargo/config.toml
+++ b/.cargo/config.toml
@@ -35,8 +35,3 @@ RUSTC_BOOTSTRAP = "crown,script,script_webgpu,script_bindings,style_tests,mozjs,
 [build]
 rustdocflags = ["--document-private-items"]
 
-[source.crates-io]
-replace-with = "vendored-sources"
-
-[source.vendored-sources]
-directory = "vendor/"
